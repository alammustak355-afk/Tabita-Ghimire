# GEMINI_API_KEY: Required for Gemini AI API calls (gemini-3.8-flash, gemini-3.8-flash-tts, gemini-4-argon).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (Automatically injected by AI Studio Cloud SQL Proxy)
SQL_HOST="/cloudsql/instance-connection-name"
SQL_USER="app_user"
SQL_PASSWORD="placeholder_password"
SQL_DB_NAME="postgres"

# Cloud SQL Admin Variables for Drizzle Kit Schema Migrations
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="placeholder_admin_password"

# Official Meta WhatsApp Business Cloud API Credentials (Optional - configured per tenant or environment)
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_VERIFY_TOKEN=""
META_APP_SECRET=""

# Omnichannel Social Media & Ad Boost Providers (Optional)
FACEBOOK_PAGE_ACCESS_TOKEN=""
INSTAGRAM_ACCESS_TOKEN=""
TIKTOK_BUSINESS_ACCESS_TOKEN=""

# Billing & Notifications (Optional)
STRIPE_SECRET_KEY=""
SMTP_HOST=""
